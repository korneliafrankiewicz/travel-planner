# Copy this file to `.env.local` (`cp env.example .env.local`), then restart Expo with
# `npx expo start --clear`. `.env.local` is git-ignored and is specific to your machine.
#
# Everything here is visible in the built app, so it must never hold a secret.

# Which back end the app talks to:
#   (not set)  the stand-in that runs inside the app; no server needed, any password works
#   auto       development only: the server in `server/` on the computer that runs Expo
#              (port 3000). Works on a phone, because Expo tells the app the computer's address.
#              Start the server so that it can be reached from the network: HOST=0.0.0.0
#   https://api.example.com   a real server. Plain http is only accepted in development.
EXPO_PUBLIC_API_URL=auto
