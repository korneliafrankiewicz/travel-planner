# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# env files
.env
.env.*
!.env.example

# test coverage and other generated reports (never committed)
coverage/
.nyc_output/
report/
reports/

# Claude Code local settings
.claude/settings.local.json

# development databases of the back end (server/.data and any server/.data-* folder)
server/.data*/

# Playwright end-to-end tests: reports, traces and the throwaway back end of a run
playwright-report/
test-results/
e2e/.tmp/
