# Copy this file to `.env` for local development (`cp env.example .env`). `.env` is git-ignored:
# never commit it. Every value has a default, so the server also starts without a `.env` file.

NODE_ENV=development
# 127.0.0.1 listens on this computer only. To reach the server from a phone on the same network
# while developing, use HOST=0.0.0.0 (then everyone on that network can reach it).
HOST=127.0.0.1
PORT=3000

# Leave empty to use the built-in development database (PGlite, stored in PGLITE_DIR).
# In production this is required, e.g. postgres://user:password@host:5432/travel_planner
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Origins of web builds that may call the API, separated by commas. Phones and simulators do not
# need CORS. Example for the Expo web build: http://localhost:8081
CORS_ORIGINS=http://localhost:8081

# Set to true only when the server runs behind a proxy you control (so rate limiting sees the
# real client address instead of the proxy's).
TRUST_PROXY=false

SESSION_TTL_DAYS=30
RESET_TTL_MINUTES=60

# Cost of hashing a password. 131072 (2^17) is the recommended minimum for production.
SCRYPT_N=131072

# Link in the password reset email; the token is added as ?token=...
# The app's own scheme only opens the app in a development or production build. In Expo Go the
# link looks like exp://192.168.1.20:8081/--/reset-password (your computer's address).
PASSWORD_RESET_URL=travel-planner://reset-password

# "console" prints the reset link in the server log, for development only. The server refuses to
# start in production with it, because no real mail provider is connected yet.
MAIL_TRANSPORT=console

LOG_LEVEL=info
